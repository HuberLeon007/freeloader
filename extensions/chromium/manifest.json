{
  "manifest_version": 3,
  "name": "Freeloader",
  "version": "0.1.0",
  "description": "Send explicit HTTP(S) download links to Freeloader.",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "scripting", "storage"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Freeloader", "default_popup": "popup.html"},
  "icons": {},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"},
  "key": "REPLACE_WITH_RELEASE_PUBLIC_KEY"
}
