{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freeloader",
  "version": "0.1.0",
  "identifier": "io.freeloader.desktop",
  "build": {"beforeDevCommand":"pnpm --dir apps/desktop dev","beforeBuildCommand":"pnpm --dir apps/desktop build","devUrl":"http://localhost:1420","frontendDist":"../dist"},
