# ---------------------------------------------------------------------------
# Rust / Cargo
# ---------------------------------------------------------------------------
target/
**/target/
*.pdb
*.rlib
*.rmeta
*.orig
*.profraw
*.profdata
# Cargo.lock IS committed: this workspace produces binaries, not libraries.

# ---------------------------------------------------------------------------
# Tauri
# ---------------------------------------------------------------------------
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/WixTools/
apps/desktop/src-tauri/.tauri/
*.msi
*.msi.zip
*.nsis.zip
*.exe.sig
*.msi.sig

# Tauri updater / code signing material must never be committed.
*.pem
*.key
*.pfx
*.p12
tauri.conf.local.json

# ---------------------------------------------------------------------------
