!.yarn/releases
!.yarn/plugins
!.yarn/versions
dist/
dist-ssr/
build/
.vite/
.turbo/
*.tsbuildinfo
.eslintcache
.stylelintcache
stats.html

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.vitest/

